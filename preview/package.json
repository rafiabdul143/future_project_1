{
  "name": "foodie-express-preview",
  "version": "1.0.0",
  "description": "FoodieExpress Preview Server with Sample Data",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "restart": "pm2 restart foodie-preview || npm start",
    "logs": "pm2 logs foodie-preview || echo 'No PM2 process found'",
    "minimal": "MINIMAL=true node server.js",
    "simulate:orders": "node simulators/orders.js",
    "simulate:delivery": "node simulators/delivery.js",
    "simulate:traffic": "node simulators/traffic.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "socket.io": "^4.7.2",
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "food-delivery",
    "preview",
    "demo",
    "express",
    "socket.io"
  ],
  "author": "FoodieExpress Team",
  "license": "MIT"
}
